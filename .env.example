# Optional: exact name of an installed Ollama image-capable model.
OLLAMA_MODEL=
# Docker can reach a host service through the host gateway, if it is listening there.
OLLAMA_URL=http://host.docker.internal:11434

# Lock every address (strongest read-only deployment).
LOCKED_MODE=false
# Comma-separated hostnames; each also locks its subdomains, on every port.
# Example: inspiration.example.com
LOCKED_DOMAINS=
# Required for editing on other addresses when LOCKED_DOMAINS is set.
# Generate with: openssl rand -hex 32. Never use a VITE_ variable for this secret.
WRITE_TOKEN=
